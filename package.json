{
  "name": "callshield",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test \"tests/unit/*.test.ts\"",
    "test:demo": "node scripts/demo-check.mjs",
    "test:smoke": "node scripts/smoke-check.mjs",
    "test:a11y": "node scripts/a11y-check.mjs",
    "test:security": "node scripts/security-check.mjs",
    "test:routes": "node scripts/verify-user-routes.mjs",
    "test:voice": "node scripts/voice-check.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "mongodb": "^7.8.0",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "playwright": "^1.65.0",
    "postcss": "^8.5.23",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
