# MongoDB (Atlas) — per-user call history, blocklist, and rate-limit windows.
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/callshieldAI?retryWrites=true&w=majority
MONGODB_URI=

# NextAuth — required in production (the app refuses to start without it).
# Generate with: npx auth secret
AUTH_SECRET=

# Set only when the app runs behind a host/proxy you control and is not on
# Vercel. Required for local `next start` checks; leave unset in production
# unless you understand forwarded-host trust.
# AUTH_TRUST_HOST=true

# Google OAuth credentials — create an OAuth client at
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Without MONGODB_URI and the Google credentials the app cannot sign in;
# history and blocklist are stored per Google account in MongoDB.

# Gnani voice integration (optional; captions-only when absent).
# Server-side only. Never prefix with NEXT_PUBLIC_.
# GNANI_API_KEY=
# Must be https in production. http://localhost is allowed only in development.
# GNANI_BASE_URL=https://api.vachana.ai
# GNANI_TTS_MODEL=timbre-v2.5
# GNANI_STT_MODEL=prisma-v2.5

# Optional voice cloning: path or base64 data URI of a consenting 5–30s clip.
# Do not commit personal reference audio to a public repository.
# GNANI_CLONE_AUDIO=
